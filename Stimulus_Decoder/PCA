      "source": [
        "from sklearn.decomposition import PCA\n",
        "\n",
        "# Reload best checkpoint (safe to repeat even if already loaded above)\n",
        "model.load_state_dict(torch.load(\"best_calcium_model.pth\"))\n",
        "model.to(device)\n",
        "model.eval()\n",
        "\n",
        "all_hidden = []\n",
        "all_labels_viz = []\n",
        "\n",
        "with torch.no_grad():\n",
        "    for X_batch, y_batch in DataLoader(full_dataset, batch_size=32):\n",
        "        X_batch = X_batch.to(device)\n",
        "        _, h_n = model.gru(X_batch)          # pull out the hidden state, not the final prediction\n",
        "        all_hidden.append(h_n[-1].cpu().numpy())\n",
        "        all_labels_viz.append(y_batch.numpy())\n",
        "\n",
        "all_hidden = np.concatenate(all_hidden)\n",
        "all_labels_viz = np.concatenate(all_labels_viz)\n",
        "\n",
        "pca = PCA(n_components=2)\n",
        "hidden_2d = pca.fit_transform(all_hidden)\n",
        "\n",
        "plt.figure(figsize=(7, 6))\n",
        "scatter = plt.scatter(hidden_2d[:, 0], hidden_2d[:, 1], c=all_labels_viz, cmap='tab10', alpha=0.7)\n",
        "plt.legend(*scatter.legend_elements(), title=\"Orientation\")\n",
        "plt.xlabel(\"PC1\")\n",
        "plt.ylabel(\"PC2\")\n",
        "plt.title(\"RNN hidden states colored by stimulus orientation\")\n",
        "plt.savefig(\"hidden_state_pca.png\", dpi=150, bbox_inches='tight')\n",
        "plt.show()"
